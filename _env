# LogWatcher Environment Configuration
# Copy this file to .env and fill in your values.

# Options: ollama, openai, anthropic, or offline
PROVIDER=ollama
DEBUGGING=1
SYSTEMD=1
MAX_QUEUE_SIZE=100
FLUSH_INTERVAL=60

# API Keys
OPENAI_KEY=<your_openai_api_key_here>
ANTHROPIC_KEY=<your_anthropic_api_key_here>

# Ollama
OLLAMA_URL=http://192.168.1.101:11434/api/generate

# Editor
EDITOR_AUTH_USER=<USERNAME>
EDITOR_AUTH_PASSWORD=<PASSWORD>

